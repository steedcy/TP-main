# syntax=docker/dockerfile:1

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r airportai \
 && useradd -r -g airportai -d /app -s /usr/sbin/nologin airportai

COPY prebuilt/airport-ai-app.jar /app/airport-ai-app.jar
COPY prebuilt/device-simulator-runtime.jar /app/device-simulator-runtime.jar
COPY prebuilt/bootstrap /app/bootstrap

RUN chown -R airportai:airportai /app

USER airportai
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=30s \
  CMD curl -fsS http://127.0.0.1:8080/actuator/health | grep -q '"status":"UP"' || exit 1

ENTRYPOINT ["java", "-Xms512m", "-Xmx2g", "-jar", "/app/airport-ai-app.jar"]
